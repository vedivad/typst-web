{
  "name": "typsten",
  "version": "0.1.0",
  "description": "Typst engine (compile, render, IDE, format) as one wasm module. Built from the Rust crate in this directory via wasm-pack.",
  "files": [
    "pkg/typsten.js",
    "pkg/typsten.d.ts",
    "pkg/typsten_bg.wasm",
    "pkg/typsten_bg.wasm.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "pkg/typsten.js",
  "module": "pkg/typsten.js",
  "types": "pkg/typsten.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/typsten.d.ts",
      "default": "./pkg/typsten.js"
    },
    "./typsten_bg.wasm": "./pkg/typsten_bg.wasm"
  },
  "scripts": {
    "build": "wasm-pack build --target web"
  }
}
