{
  "name": "@vedivad/typst-web-service",
  "version": "0.17.0",
  "description": "Editor-agnostic Typst compilation service running in a Web Worker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vedivad/typst-web.git",
    "directory": "packages/typst-web-service"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "fflate": "^0.8.2",
    "nanotar": "^0.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "typsten": "workspace:*"
  }
}
